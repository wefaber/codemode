{
  "name": "codemode",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "tsc --noEmit && oxlint && bun test",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "release": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.2",
    "@sinclair/typebox": "^0.34.52",
    "@wefaber/codemode": "workspace:*",
    "@wefaber/codemode-mcp": "workspace:*",
    "@wefaber/codemode-sandbox-quickjs": "workspace:*",
    "@wefaber/codemode-cli": "workspace:*"
  }
}
