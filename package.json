{
  "name": "codemode",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "lefthook install || true",
    "verify": "bun check && oxlint && bun test",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "release": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@types/bun": "^1.4.4",
    "@wefaber/codemode": "workspace:*",
    "@wefaber/codemode-cli": "workspace:*",
    "@wefaber/codemode-mcp": "workspace:*",
    "@wefaber/codemode-sandbox-quickjs": "workspace:*",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.2"
  }
}
